# Copy to .env, then fill in real values.
# docker-compose reads .env via `env_file`. When running the standalone binary,
# either source .env into your shell or use a tool like `direnv`.
# config.yaml.example references these with ${VAR} substitution at load time.

# Required: JWT signing key. Rotate = invalidates all active sessions.
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here

# Required: bootstrap admin credentials. Used only on the first run when the
# users table is empty. Change the password from the admin UI afterwards.
ADMIN_EMAIL=admin@sub2balance.local
ADMIN_PASSWORD=change-me

# Note: Sub2API upstream (base_url, api_key) is no longer set here.
# Log in as admin and configure it at /admin/settings in the web UI.
